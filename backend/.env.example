# Copy this file to backend/.env and fill in key.
>>>>>>> 3be8a11 (Deploy config, cold-start handling, warm-up polling)
#   cp .env.example .env
# .env is gitignored; this file is the one that gets committed.

# Free key from https://newsapi.org/register (100 requests/day on the free tier).
# Without it, country-level pins show as "no data" — city level still works,
# because Google News RSS needs no key.
NEWS_API_KEY=api_key

# Point this at a GNews-compatible mirror if you'd rather use that provider.
NEWS_API_BASE_URL=https://newsapi.org/v2

# Hours before a cached region is re-fetched. 12 countries / 4 hours = 72
# requests a day, which fits inside the free tier with room to spare.
CACHE_TTL_HOURS=4

# Pause between calls during a full warm-up, in seconds. Be kind to free tiers.
FETCH_DELAY_SECONDS=1.5

# true swaps VADER for distilbert-base-uncased-finetuned-sst-2-english.
# Much slower, needs the optional deps in requirements.txt, and produces a more
# polarised map — see docs/methodology.md before turning it on.
HIGH_ACCURACY_MODE=false

# Trim the map without editing regions.json. Empty means "every country in the file".
SUPPORTED_COUNTRIES=us,gb,in,de,jp,br,au,ca,fr,za,ae,sg

# Where the SQLite cache lives.
SQLITE_PATH=data/cache.db

# The Vite dev server. Add your deployed frontend origin here too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
